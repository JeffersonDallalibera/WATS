{
  "database": {
    "type": "sqlserver",
    "server": "",
    "database": "",
    "username": "",
    "password": "",
    "port": "1433"
  },
  "recording": {
    "auto_start": true,
    "mode": "rdp_window",
    "output_dir": "{USERPROFILE}/Videos/Wats",
    "fps": 5,
    "quality": 40,
    "resolution_scale": 1.0,
    "max_file_size_mb": 1024,
    "max_duration_minutes": 30,
    "max_total_size_gb": 10.0,
    "max_file_age_days": 30,
    "cleanup_interval_hours": 6,
    "smart_recording": {
      "window_tracking_interval": 1.0,
      "inactivity_timeout_minutes": 5,
      "pause_on_minimized": true,
      "pause_on_covered": true,
      "create_new_file_after_pause": true,
      "debug_window_tracking": false,
      "debug_activity_monitoring": false
    },
    "compression": {
      "enabled": true,
      "crf": 28,
      "preset": "veryfast"
    },
    "session_protection": {
      "enabled": true,
      "sanitize_metadata": true,
      "remove_sensitive_fields": true,
      "log_protection_actions": true
    }
  },
  "application": {
    "log_level": "INFO",
    "theme": "Dark",
    "auto_consent": true,
    "window_title": "WATS",
    "window_geometry": "1200x800",
    "window_resizable": true,
    "minimize_to_tray": true,
    "start_minimized": false,
    "check_updates": true,
    "language": "pt-BR",
    "monitor": 2
  },
  "rdp": {
    "maximize_window": true,
    "window_mode": "windowed",
    "allow_window_override": true,
    "fullscreen": false,
    "default_width": 1920,
    "default_height": 1080
  },
  "performance": {
    "max_cpu_usage_percent": 80,
    "memory_limit_mb": 1024,
    "disk_space_check_enabled": true,
    "min_free_space_gb": 5,
    "background_cleanup_enabled": true,
    "optimize_for_battery": false,
    "db_pool_size": 5,
    "db_max_overflow": 10,
    "cache_ttl_seconds": 300,
    "cache_max_size": 1000
  }
}